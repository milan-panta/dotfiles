# shortcuts for opening apps
rcmd - return : open -na Ghostty
rcmd - k : open -a Ghostty
rcmd - j : open -a "Google Chrome"
rcmd - p : ~/.config/skhd/scripts/focus-mpv.sh
shift + lcmd - j : open -na "Google Chrome"
rcmd - b : open -a Messages
rcmd - l : open -a Claude
rcmd - c : open -a /Applications/Calendar.app
rcmd - s : open -a Spotify
rcmd - d : open -a Discord
rcmd - m : open -a Mail
rcmd - o : open -a OBS

# open things in the terminal
lcmd + ctrl - t : ~/.config/skhd/scripts/launch-tui.sh btop
lcmd + ctrl - m : ~/.config/skhd/scripts/launch-tui.sh spotify_player

# ---------- Window management (rift) ----------
# Rift's native [keys] can't tell left/right modifiers apart, so bindings live
# here and call rift-cli. Workspace ids are 0-based. Float toggle (lalt - t)
# is in ~/.config/rift/config.toml: only Rift's own binding can center it.

# restart rift
ctrl + alt + cmd - r : rift service restart

# toggle tiling on the current workspace (bsp <-> float)
ctrl + alt + cmd - t : ~/.config/skhd/scripts/toggle-layout.sh

# focus window
lalt - h : rift-cli execute window focus left
lalt - k : rift-cli execute window focus up
lalt - l : rift-cli execute window focus right
lalt - j : rift-cli execute window focus down

# flip the focused split (closest rift equivalent of yabai's rotate)
lalt - r : rift-cli execute layout toggle-orientation

# maximize window
lalt - m : rift-cli execute window toggle-fullscreen

# Fast focus workspaces
lalt - 1 : rift-cli execute workspace switch 0
lalt - 2 : rift-cli execute workspace switch 1
lalt - 3 : rift-cli execute workspace switch 2
lalt - 4 : rift-cli execute workspace switch 3
lalt - 5 : rift-cli execute workspace switch 4
lalt - 6 : rift-cli execute workspace switch 5
lalt - 7 : rift-cli execute workspace switch 6
lalt - 8 : rift-cli execute workspace switch 7
lalt - 9 : rift-cli execute workspace switch 8

# Move window to workspace and focus workspace
lalt + shift - 1 : rift-cli execute workspace move-window --follow 0
lalt + shift - 2 : rift-cli execute workspace move-window --follow 1
lalt + shift - 3 : rift-cli execute workspace move-window --follow 2
lalt + shift - 4 : rift-cli execute workspace move-window --follow 3
lalt + shift - 5 : rift-cli execute workspace move-window --follow 4
lalt + shift - 6 : rift-cli execute workspace move-window --follow 5
lalt + shift - 7 : rift-cli execute workspace move-window --follow 6
lalt + shift - 8 : rift-cli execute workspace move-window --follow 7
lalt + shift - 9 : rift-cli execute workspace move-window --follow 8

# focus monitor
lcmd + shift - l : rift-cli execute display focus --direction right
lcmd + shift - h : rift-cli execute display focus --direction left

# send window to monitor and follow focus
ctrl + lcmd - l : rift-cli execute display move-window --direction right; rift-cli execute display focus --direction right
ctrl + lcmd - h : rift-cli execute display move-window --direction left; rift-cli execute display focus --direction left

# swap windows
shift + lalt - j : rift-cli execute layout move-node down
shift + lalt - k : rift-cli execute layout move-node up
shift + lalt - h : rift-cli execute layout move-node left
shift + lalt - l : rift-cli execute layout move-node right

# increase window size
ralt - left : rift-cli execute window resize-grow --orientation horizontal
ralt - right : rift-cli execute window resize-grow --orientation horizontal
ralt - up : rift-cli execute window resize-grow --orientation vertical
ralt - down : rift-cli execute window resize-grow --orientation vertical

# decrease window size
rcmd - left : rift-cli execute window resize-shrink --orientation horizontal
rcmd - right : rift-cli execute window resize-shrink --orientation horizontal
rcmd - up : rift-cli execute window resize-shrink --orientation vertical
rcmd - down : rift-cli execute window resize-shrink --orientation vertical

# resize windows
lalt - a : rift-cli execute window resize-shrink --orientation horizontal
lalt - f : rift-cli execute window resize-grow --orientation horizontal
lalt - s : rift-cli execute window resize-grow --orientation vertical
lalt - d : rift-cli execute window resize-shrink --orientation vertical
